{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/claude/pre-bash.js\"",
            "timeout": 10,
            "statusMessage": "verx: revisando el comando"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/claude/post-edit.js\"",
            "timeout": 60,
            "statusMessage": "verx-guard: revisando reglas"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/claude/stop.js\"",
            "timeout": 180,
            "statusMessage": "verx: guardián y tests antes de terminar"
          }
        ]
      }
    ]
  }
}
